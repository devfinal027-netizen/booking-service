# Core service
NODE_ENV=development
PORT=4000
BOOKING_PORT=4000
PUBLIC_BASE_URL=http://localhost:4000

# Database
MONGO_URI=mongodb://localhost:27017/booking

# Authentication & Authorization
AUTH_JWKS_URL=
AUTH_AUDIENCE=
AUTH_ISSUER=
AUTH_BASE_URL=http://localhost:3000
AUTH_SERVICE_BEARER=
AUTH_DEBUG=0
JWT_SECRET=change-me
JWT_AUDIENCE=
JWT_ISSUER=

# Admin & pricing
ADMIN_USER_ID=
COMMISSION_RATE=15

# Dispatch & proximity tuning
BROADCAST_RADIUS_KM=5
RADIUS_KM=5
BROADCAST_MAX_DRIVERS=50
DISPATCH_TTL_MS=60000
EMIT_ONCE_TTL_MS=60000

# Live location streaming
POSITION_UPDATE_INTERVAL_MS=5000
LIVE_USE_CHANGE_STREAMS=true
LIVE_SNAPSHOT_TTL_SECONDS=2592000

# External services
SANTIMPAY_BASE_URL=https://gateway.santimpay.com/api
SANTIMPAY_NOTIFY_URL=
SANTIMPAY_WITHDRAW_NOTIFY_URL=
WALLET_WEBHOOK_DEBUG=0
USER_SERVICE_TIMEOUT_MS=5000
HTTP_TIMEOUT_MS=5000

# Cryptography
PRIVATE_KEY=
PUBLIC_KEY=
PRIVATE_KEY_PATH=
PUBLIC_KEY_PATH=
PRIVATE_KEY_IN_PEM=

# Payment gateway
GATEWAY_MERCHANT_ID=

